flowchart LR

  S1["<b>① AOI</b><br/><font size=2>Area of Interest</font><br/><br/>Define study boundary<br/>on the interactive map"]:::aoi
  S2["<b>② Imagery Acquisition</b><br/><font size=2>Street-Level Sources</font><br/><br/>Mapillary · Google Street View<br/>Panoramas + camera metadata"]:::imagery
  S3["<b>③ Detection & Classification</b><br/><font size=2>Computer Vision</font><br/><br/><b>Primary assets</b><br/>Street Lights · Poles<br/><b>Also</b> Signals · Vehicles · Trees"]:::detect
  S4["<b>④ Geospatial Localization</b><br/><font size=2>Position on Earth</font><br/><br/>Camera pose + bearing<br/>Height-based distance<br/>Multi-view triangulation"]:::geo
  S5["<b>⑤ Asset Mapping</b><br/><font size=2>Geo Inventory</font><br/><br/>Map-ready asset layer<br/>Per-class pins & clusters"]:::map
  S6["<b>⑥ Visualization & Analytics</b><br/><font size=2>Decision Support</font><br/><br/>Dashboard · KPIs · filters<br/>Map · imagery · exports"]:::viz

  S1 ==> S2 ==> S3 ==> S4 ==> S5 ==> S6

