MAPILLARY_ACCESS_TOKEN=your_mapillary_token_here
# Green Mapillary coverage dots/lines on the map (true | false)
SHOW_MAPILLARY_COVERAGE=true
# Set on inference server Docker container (not required in backend when INFERENCE_SEND_API_KEY=false)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
# Local inference server URL (Docker). Backend does NOT call Roboflow cloud API for detection.
INFERENCE_SERVER_URL=http://host.docker.internal:9001
# true = backend sends ROBOFLOW_API_KEY with each request (recommended with inference server start)
INFERENCE_SEND_API_KEY=true
# If inference runs in the same Docker Compose network: INFERENCE_SERVER_URL=http://inference:9001
# If you run backend locally (not Docker), use:
# INFERENCE_SERVER_URL=http://localhost:9001
ROBOFLOW_WORKSPACE=power-house
# https://universe.roboflow.com/power-house/vehicle-detection-7nnx0/model/4
PROJECT_ID=vehicle-detection-7nnx0
MODEL_VERSION=4
# Secondary street-light specialist model
# https://universe.roboflow.com/stret-light/street-light-ci0on/model/1
STREET_LIGHT_WORKSPACE=stret-light
STREET_LIGHT_PROJECT_ID=street-light-ci0on
STREET_LIGHT_MODEL_VERSION=1
ENABLE_STREET_LIGHT_MODEL=true
# Traffic-signal specialist model (app-wide, including GSV continued)
# https://universe.roboflow.com/power-house/traffic-signal-sg7ou/model/4
TRAFFIC_SIGNAL_WORKSPACE=power-house
TRAFFIC_SIGNAL_PROJECT_ID=traffic-signal-sg7ou
TRAFFIC_SIGNAL_MODEL_VERSION=4
ENABLE_TRAFFIC_SIGNAL_MODEL=true
# GSV Continued page only — extra models (run in parallel with the three above)
# https://universe.roboflow.com/street-light-pkozz/street-light-pkozz/model/1
GSV_STREET_LIGHT_PK0ZZ_PROJECT_ID=street-light-pkozz
GSV_STREET_LIGHT_PK0ZZ_MODEL_VERSION=1
ENABLE_GSV_STREET_LIGHT_PK0ZZ=true
# https://universe.roboflow.com/street-view-traffic-signs/street-view-traffic-signs/model/3
GSV_TRAFFIC_SIGNS_PROJECT_ID=street-view-traffic-signs
GSV_TRAFFIC_SIGNS_MODEL_VERSION=3
ENABLE_GSV_TRAFFIC_SIGNS=true
# https://universe.roboflow.com/traffic-light-1wdof/traffic-light-1wdof/model/3
GSV_TRAFFIC_LIGHT_1WDOF_PROJECT_ID=traffic-light-1wdof
GSV_TRAFFIC_LIGHT_1WDOF_MODEL_VERSION=3
ENABLE_GSV_TRAFFIC_LIGHT_1WDOF=true
# https://universe.roboflow.com/3-l0e9t/3-l0e9t/model/14
GSV_STREET_ASSETS_3L0E9T_PROJECT_ID=3-l0e9t
GSV_STREET_ASSETS_3L0E9T_MODEL_VERSION=14
ENABLE_GSV_STREET_ASSETS_3L0E9T=true
# GSV Continued: ignore pole/light/sign boxes covering more than 50% of the image
GSV_MAX_BBOX_RATIO=0.50
# Optional detection tuning
DETECTION_IOU_THRESHOLD=0.5
DETECTION_CONFIDENCE_MIN=0.25
VITE_API_URL=http://localhost:8000
# When using Docker Compose, frontend uses /api proxy instead (see docker-compose.yml).
# For local npm run dev without Docker, you can use /api with vite proxy:
# VITE_API_URL=/api
# Geolocation (bbox bearing + multi-view LOB triangulation)
HORIZONTAL_FOV_DEG=90
HFOV_SCALE=1.0
COMPASS_BEARING_OFFSET_DEG=0
DEFAULT_OBJECT_DISTANCE_M=15
MIN_OBJECT_DISTANCE_M=3
LOB_MAX_LENGTH_M=50
LOB_MIN_VIEWS=3
LOB_MIN_VIEWS_STATIC=2
LOB_CLUSTER_RADIUS_M=10
LOB_ANGLE_THRESHOLD_DEG=3
ASSUMED_POLE_HEIGHT_M=8
ASSUMED_STREET_LIGHT_HEIGHT_M=6
ASSUMED_TRAFFIC_SIGNAL_HEIGHT_M=5
ASSUMED_TRAFFIC_SIGNAL_HEAD_HEIGHT_M=1.2
ASSUMED_TRAFFIC_SIGNAL_MOUNT_HEIGHT_M=5.5
TRAFFIC_SIGNAL_POLE_EXTEND_RATIO=2.0
GEOLOCATE_MIN_BBOX_WIDTH_FOR_QUALITY=12
# GSV map session fusion + intersection corner snap
GSV_LOC_CLUSTER_RADIUS_M=12
GSV_SESSION_CLUSTER_RADIUS_M=10
GSV_LOB_ANGLE_THRESHOLD_DEG=3
SNAP_SEARCH_RADIUS_M=40
INTERSECTION_CORNER_OFFSET_M=8
SNAP_MAX_DISPLACEMENT_M=25
SNAP_ROADSIDE_MAX_DISPLACEMENT_M=35
ROAD_EDGE_OFFSET_M=7
ROAD_PROXIMITY_MAX_M=25
ROADSIDE_ACCEPT_MAX_M=12
SNAP_ROADSIDE_CLASSES=Street Light,Pole
SNAP_OSM_WAYS_ENABLED=true
GSV_OFFICIAL_STATIC_ONLY=false
GSV_EXCLUDE_BEARING_SINGLE=true
GSV_FUSION_BEARING_AGREE_DEG=5
# Tune against backend/tests/fixtures/gsv_geo/validation_zones.json
# HFOV_SCALE=1.0
# COMPASS_BEARING_OFFSET_DEG=0
# ASSUMED_STREET_LIGHT_HEIGHT_M=6
# TRAFFIC_SIGNAL_POLE_EXTEND_RATIO=2.0
# GSV_HORIZONTAL_FOV_DEG=90
SNAP_USE_GEOMETRIC_FALLBACK=true
OVERPASS_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter
CAMERA_ALTITUDE_M=2.5
# Object locations are computed automatically when a batch finishes (Mapillary camera + multi-view).
USE_3D_CAMERA_RAY=true
# Use Mapillary SfM heading instead of EXIF (usually worse for LOB triangulation)
# USE_COMPUTED_COMPASS_ANGLE=false
# PitOrlManh local GSV dataset (GSV continued page)
# Copy dataset to ./Dataset_PitOrlManh then build index:
#   pip install scipy
#   python backend/scripts/build_gsv_continued_index.py
# Re-run after adding image parts or changing nav logic (forward/back/left/right links).
GSV_CONTINUED_ROOT=./Dataset_PitOrlManh
# UCF mat compass is CCW from north; convert to standard bearing for geo (set false if pins mirror)
GSV_COMPASS_CCW=true
# Optional HFOV override for PitOrlManh tiles (default: reuse HORIZONTAL_FOV_DEG=90)
# GSV_HORIZONTAL_FOV_DEG=90
